# --- Archivos sensibles y credenciales ---
.env
ansible/group_vars/all.yml
# Añade esto para proteger si creas copias de seguridad de tus llaves o vault
*.key
*.vault
*.private

# --- Datos de las bases de datos ---
mariadb_data/
postgres_data/
mongo_data/

# --- Backups ---
backups/

# --- Logs y archivos temporales ---
*.log
*.tmp
.DS_Store
.ansible-cache/
__pycache__/

# --- Docker ---
*.pid
# Añade esto por si alguna vez usas archivos de override de docker-compose
docker-compose.override.yml

# --- Ansible / Configuraciones locales ---
# Es bueno ignorar cualquier archivo de inventario local o de pruebas que no quieras subir
hosts
ansible.log


# --- Tus Scripts generados ---
# No queremos subir los scripts que Ansible genera en /tmp o localmente
/tmp/*.sh

# --- Archivos de despliegue locales ---
# Si alguna vez usas archivos de variables específicos para tu máquina local
group_vars/local.yml

# --- Archivos de respaldo de base de datos ---
# Asegúrate de que las rutas relativas funcionen
backups/
/backups/


# --- Archivos generados dinámicamente por Ansible (Resultados) ---
# Si Ansible genera los archivos en los directorios de configs o en la raíz, ignóralos:
configs/mariadb/init.sql
configs/postgres/init.sql
configs/mongo/init.js
docker-compose.yml

# --- Archivos de estado de Docker ---
# A veces Docker crea archivos de red o estados, mejor ignorarlos
.docker/

# --- Scripts generados por Ansible (Contienen secretos inyectados) ---
/usr/local/bin/backups.sh
/tmp/restore_db.sh
