// Script de inicialización de MongoDB dinámico
db = db.getSiblingDB('admin');
db.auth('{{ mongo_root_username }}', '{{ mongo_root_password }}');

// Crear bases de datos y usuarios de aplicación
{% for db in mongo_databases %}
db = db.getSiblingDB('{{ db.name }}');
db.createUser({
  user: '{{ db_app_user }}',
  pwd: '{{ db_app_password }}',
  roles: [ { role: 'readWrite', db: '{{ db.name }}' } ]
});
{% endfor %}
