---
# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (all.yml.example)
# Copia este archivo como 'all.yml' y ajusta los valores según tu entorno.
# ==============================================================================

# --- Credenciales para las Aplicaciones ---
# Usuario y contraseña que usan tus aplicaciones (WP, GLPI, etc.) para conectar
db_app_user: "usuario_aplicacion_ejemplo"
db_app_password: "CONTRASEÑA_SEGURA_APLICACION"

# --- Listas de Bases de Datos ---
# Añade aquí todos los esquemas que tus servicios necesiten
mariadb_databases:
  - name: "wordpress_db"
  - name: "glpi_db"

postgres_databases:
  - name: "zabbix_db"
  - name: "n8n_db"

mongo_databases:
  - name: "logs_db"

# --- Credenciales de Administración (ROOT / ADMIN) ---
# Cambia estos valores por contraseñas únicas y robustas
mariadb_root_password: "CONTRASEÑA_ROOT_MARIADB"

postgres_user: "administrador_postgres"
postgres_password: "CONTRASEÑA_ADMIN_POSTGRES"
postgres_db: "nombre_base_datos_inicial"

mongo_root_username: "admin_mongo"
mongo_root_password: "CONTRASEÑA_ROOT_MONGO"

# --- Configuración Específica de Servicios ---
# Clave secreta para Authentik (Generar con: openssl rand -base64 32)
authentik_secret_key: "CLAVE_SECRETA_AUTENTIK_32_CHARS"

# Ruta base donde se despliegan los servicios
base_path: "/opt/servicios/nodo-db-core"

# --- Redes Permitidas (Firewall) ---
# IPs o subredes que tienen permiso para hacer consultas a las DBs
allowed_db_networks:
  - "100.64.0.0/10"      # Ejemplo: Rango de Tailscale
  - "192.168.1.0/24"     # Ejemplo: Tu red local (LAN)
  - "172.16.0.0/16"      # Red interna de contenedores Docker
  - "10.0.0.0/8"         # Red de VPN corporativa o secundaria

# --- Configuración de Backups ---
backup_retention_days: 7 # Días antes de eliminar respaldos antiguos
backup_cron_hour: "03"    # Hora en formato 24h para el respaldo
backup_cron_minute: "00"  # Minuto exacto
